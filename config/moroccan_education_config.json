{
  "api": {
    "name": "Moroccan Education API",
    "version": "1.0.0",
    "description": "Comprehensive public API for Moroccan education data",
    "contact_email": "prs.online.00@gmail.com",
    "github": "https://github.com/K11E3R/moroccan-education-API"
  },
  "data_sources": [
    {
      "name": "men.gov.ma",
      "url": "https://www.men.gov.ma",
      "description": "Ministry of National Education — Official curricula",
      "type": "official"
    },
    {
      "name": "AlloSchool",
      "url": "https://www.alloschool.com",
      "description": "Courses, exercises, exams for all Moroccan education levels",
      "type": "educational_platform"
    },
    {
      "name": "9rayti",
      "url": "https://9rayti.com",
      "description": "Education resources, orientation, and study guides",
      "type": "educational_platform"
    },
    {
      "name": "Dyrassa",
      "url": "https://www.dyrassa.com",
      "description": "Educational content platform for Moroccan students",
      "type": "educational_platform"
    },
    {
      "name": "Telmidtice",
      "url": "https://telmidtice.men.gov.ma",
      "description": "Official e-learning platform by the Ministry",
      "type": "official"
    },
    {
      "name": "TaalimPress",
      "url": "https://taalimpress.info",
      "description": "Moroccan education news and resources",
      "type": "news"
    }
  ],
  "scraping_config": {
    "respect_robots": true,
    "delay_between_requests": 2.0,
    "max_concurrent_requests": 5,
    "timeout": 30,
    "user_agent": "MoroccanEducationBot/1.0 (Educational Research)"
  },
  "education_structure": {
    "categories": ["primaire", "college", "lycee"],
    "levels_per_category": {
      "primaire": 6,
      "college": 3,
      "lycee": 3
    },
    "content_types": [
      "cours",
      "exercice",
      "examen",
      "controle",
      "correction",
      "resume"
    ],
    "languages": ["fr", "ar"]
  },
  "quality_checks": {
    "min_title_length": 5,
    "required_fields": ["id", "title", "level_id", "subject_id", "content_type"],
    "min_content_per_subject": 3,
    "min_arabic_coverage": 0.9,
    "min_source_coverage": 0.8
  },
  "pipeline": {
    "schedule": "daily at 06:00 UTC",
    "validation_script": "pipelines/validate_data.py",
    "generator_script": "collectors/generate_quality_data.py",
    "report_path": "pipelines/quality_report.json"
  }
}
